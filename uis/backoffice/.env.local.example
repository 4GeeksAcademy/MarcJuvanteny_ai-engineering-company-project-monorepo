# Base URL of the incidents-api backend.
NEXT_PUBLIC_INCIDENTS_API_URL=http://localhost:8001

# Telemetry ingestion endpoint used by src/services/telemetry.ts.
# Defaults to `${NEXT_PUBLIC_INCIDENTS_API_URL}/telemetry/events` if unset.
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8001/telemetry/events

# Base URL of services/knowledge-api (CONTEXT7.md, RAG). Used by
# src/lib/knowledge.ts for POST /knowledge/query.
NEXT_PUBLIC_KNOWLEDGE_API_URL=http://localhost:8020

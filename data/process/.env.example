# Qdrant (ver docker-compose.yml -> servicio "qdrant"). En local con docker
# compose, http://localhost:6333 ya apunta ahi.
QDRANT_URL=http://localhost:6333

# Modelo de EMBEDDINGS -- el gratuito que 4Geeks provee a estudiantes de AI
# Engineering (proxy OpenAI-compatible). Nunca reutilizar estas credenciales
# para el modelo de generacion (fase futura, ver rag.py).
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Qdrant (ver docker-compose.yml -> servicio "qdrant").
QDRANT_URL=http://localhost:6333

# Modelo de EMBEDDINGS (usado por data/process/rag.py::embed(), reutilizado
# por data/pipelines/rag.py::retrieve()). Nunca compartir con GENERATION_*.
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Modelo de GENERACION (chat/completion) -- separado del de embeddings.
GENERATION_API_BASE=
GENERATION_API_KEY=
GENERATION_MODEL=gpt-4o-mini

# services/incidents-api -- usado por las tools del agente (tools/incidents_tool.py,
# tools/inventory_tool.py). Sirve tanto /api/incidents como /inventory/products
# (mismo proceso). Token opcional: /api/incidents* requiere auth, /inventory/products no.
INCIDENTS_API_URL=http://localhost:8001
INCIDENTS_API_TOKEN=
INCIDENTS_API_TIMEOUT_SECONDS=4

# Qdrant (ver docker-compose.yml -> servicio "qdrant").
QDRANT_URL=http://localhost:6333

# Modelo de EMBEDDINGS (usado por data/process/rag.py::embed(), reutilizado
# por data/pipelines/rag.py::retrieve()). Nunca compartir con GENERATION_*.
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Modelo de GENERACION (chat/completion) -- separado del de embeddings.
GENERATION_API_BASE=
GENERATION_API_KEY=
GENERATION_MODEL=gpt-4o-mini

# mcps/trackflow-mcp -- el MCP Server que expone las tools de incidentes/inventario
# (ver mcp_client.py). El agente ya no llama a services/incidents-api directamente.
# MCP_SERVER_TOKEN: token OAuth 2.1/OIDC backend-a-backend, emitido por el
# authorization server configurado en mcps/trackflow-mcp/.env (MCPAUTH_ISSUER)
# con scopes incidents:read + inventory:read como minimo.
MCP_SERVER_URL=http://localhost:8010/mcp
MCP_SERVER_TOKEN=
MCP_TIMEOUT_SECONDS=8

# Memoria del agente (CONTEXT8.md, Hito 8 Parte 1) -- backend Redis, NUNCA
# las colecciones RAG de Qdrant (ver memory_store.py). Mismo Redis que ya
# corre en este repo (services/incidents-api, broker de Celery) -- si se
# omite, cae a REDIS_URL. Namespace de claves: "agent_memory:*".
AGENT_MEMORY_REDIS_URL=redis://localhost:6379/0
# Consolidación y Limpieza: TTL por entrada (180 dias) + tope de entradas
# totales (desaloja las de updated_at mas antiguo por encima del limite).
AGENT_MEMORY_TTL_SECONDS=15552000
AGENT_MEMORY_MAX_ENTRIES=200

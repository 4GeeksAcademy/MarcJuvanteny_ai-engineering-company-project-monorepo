# Mismo secreto que services/incidents-api/.env: los tokens que emite el
# login de incidents-api se validan aqui con la misma firma (ver auth.py).
# Mínimo 32 caracteres (se rechaza uno más corto). Mismo valor en incidents-api,
# reporting y knowledge-api. Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Conexion a la misma base que data/pipelines/ (Supabase). Solo se usa si no
# existe el Prefect block SqlAlchemyConnector "trackflow-supabase".
SUPABASE_DATABASE_URL=
# DATABASE_URL=

# JWT used to sign access tokens and password-reset tokens.
JWT_SECRET_KEY=change-me

# Minutes an access token (login session) stays valid.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Minutes a password-reset link stays valid. Must be between 15 and 60.
RESET_TOKEN_EXPIRE_MINUTES=30

# API key for the transactional email provider (Resend: https://resend.com).
# Required to actually deliver "forgot password" emails. If unset, the reset
# link is only logged to the server console (useful for local development).
RESEND_API_KEY=

# "From" address used when sending transactional emails.
EMAIL_FROM=TrackFlow <onboarding@resend.dev>

# Base URL of the backoffice frontend, used to build the password-reset link
# sent by email (e.g. https://backoffice.trackflow.example).
BACKOFFICE_APP_URL=http://localhost:3000

# URL of an external telemetry/analytics sink. Not used yet by /telemetry/events
# (which only logs and acknowledges events for now) — reserved for a future
# phase where validated events are forwarded downstream.
TELEMETRY_ENDPOINT=

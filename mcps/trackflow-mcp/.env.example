# services/incidents-api -- backend real que consultan/modifican las tools
# (GET/POST /api/incidents, PATCH /api/incidents/{id}/status, GET /inventory/products).
INCIDENTS_API_URL=http://localhost:8001
INCIDENTS_API_TOKEN=
INCIDENTS_API_TIMEOUT_SECONDS=5

# OAuth 2.1 / OIDC del proveedor real que protege este MCP Server (Auth0, Logto,
# Keycloak, Okta, ...) -- MCP Auth descubre el resto de la metadata via su
# endpoint .well-known/* a partir de este issuer. Sin esto, el servidor no arranca
# (ver auth.py::build_mcp_auth_from_env). Este repo no tiene un proveedor real
# configurado -- en desarrollo/tests se usa el emisor local de tests/dev_idp.py.
MCPAUTH_ISSUER=
MCPAUTH_SERVER_TYPE=oidc
MCPAUTH_AUDIENCE=

# Identificador publico (RFC 9728) de este MCP Server como "protected resource".
MCP_SERVER_RESOURCE_URL=http://localhost:8010/mcp

MCP_SERVER_PORT=8010
